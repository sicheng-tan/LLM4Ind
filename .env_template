# === LLM API Keys ===
OPENAI_API_KEY=sk-xxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxx
QWEN_API_KEY=sk-xxxxxxx
GEMINI_API_KEY=sk-xxxxxxx

# === Model Selection ===
# Options: gpt-4o (default, uses OPENAI_MODEL) | gpt-5 | gpt-5.5 | deepseek | qwen | gemini
MODEL_TYPE=qwen

# OpenAI-compatible endpoint (used when MODEL_TYPE is not deepseek/qwen/gemini)
# OPENAI_API_BASE=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-5
# Optional: DOTENV_PATH=/abs/path/to/experiments/configs/case.env

# === Solver Paths ===
CVC5_BINARY=./cvc/cvc5-Linux-x86_64-static/bin/cvc5
CVC4_BINARY=./cvc/cvc4_binary/cvc4-1.6-x86_64-linux-opt
VAMPIRE_BINARY=./vampire/vampire

# === Network Proxy (optional) ===
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# === Runtime Parameters (optional, defaults shown) ===
# MAX_ATTEMPTS_PER_PROMPT=3
# DEFAULT_CVC_TIMEOUT=60
# RETRY_CVC_TIMEOUT=100  # unused while the post-LLM-exhaustion retry is commented out
# COMBINED_CVC_TIMEOUT=60
# MAX_RECURSION_DEPTH=3
# TASK_TIMEOUT=1200
# PROMPT_MODE_SEED=  # optional; if set, both-kind prompt sampling is reproducible

# === Feedback-guided profile selection (optional) ===
# SOLVER_ROUTING=on
# SOLVER_ROUTING_DECIDER=relative
# Set SOLVER_ROUTING_DECIDER=llm to let the backend-specific selector
# choose a whitelisted prompt/profile pair.
# SOLVER_ROUTING_LLM_MIN_CONFIDENCE=0.55
# SOLVER_ROUTING_FALLBACK=on
# SOLVER_ROUTING_FALLBACK_FRACTION=0.25
# SOLVER_ROUTING_FALLBACK_MIN_SECONDS=5
# SOLVER_ROUTING_PROBES=on
# SOLVER_PROBE_TIMEOUT=2
# SOLVER_ROUTING_PROBE_MAX_PROFILES=3
# SOLVER_ROUTING_TOP_K=2

# Cross-attempt inheritance (optional; both default on)
# LEMMA_LIBRARY=on       # proved lemmas as axioms + library block in the prompt
# OBLIGATION_TREE=on     # last well-formed obligation tree in the prompt

# Ablation for features added on top of PaperMate (optional; all default on)
# FEEDBACK_REPAIR_HINTS=on   # solver repair hints in failed_lemmas / LLM prompt
# FEEDBACK_PROGRESS=on       # 3s sidecar + progress lemmas in the prompt
# PROMPT_RETARGET=on         # hint-family / no-help switching of generation templates
# UNPROVED_NOT_INVALID=on    # failed useful subgoals are unproved, not invalid

