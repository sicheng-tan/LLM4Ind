# 个例实验：论文原方法（关闭后续算法增量）。复制为 paper.env 后填入密钥。
# 用法：
#   DOTENV_PATH=experiments/configs/paper.env \
#     python3 run_exp_folder_vampire.py \
#     --root-path ./experiments/cases \
#     --result-dir ./experiments/results

# === LLM ===
OPENAI_API_KEY=sk-xxxxxxx
OPENAI_API_BASE=https://api.quickrouter.ai/v1
OPENAI_MODEL=qwen3-235b-a22b-instruct-2507
MODEL_TYPE=qwen3

# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# === Solver Paths ===
CVC5_BINARY=./cvc/cvc5-Linux-x86_64-static/bin/cvc5
CVC4_BINARY=./cvc/cvc4_binary/cvc4-1.6-x86_64-linux-opt
VAMPIRE_BINARY=./vampire/vampire

# === Paper runtime ===
MAX_ATTEMPTS_PER_PROMPT=3
DEFAULT_CVC_TIMEOUT=60
COMBINED_CVC_TIMEOUT=60
MAX_RECURSION_DEPTH=3
TASK_TIMEOUT=1200
MAX_PARALLEL_TASKS=2

# === 论文原闭环：关 routing / 引理库 / 义务树 / 失败反馈 / prompt 重选 ===
SOLVER_ROUTING=off
SOLVER_ROUTING_DECIDER=relative
SOLVER_ROUTING_PROBES=off
LEMMA_LIBRARY=off
OBLIGATION_TREE=off
FEEDBACK_REPAIR_HINTS=off
FEEDBACK_PROGRESS=off
PROMPT_RETARGET=off
UNPROVED_NOT_INVALID=off
