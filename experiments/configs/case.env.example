# 个例实验配置模板。复制为 case.env 后填入密钥。
# 对齐论文默认 Qwen3-235B-instruct：QuickRouter 模型 ID 为 qwen3-235b-a22b-instruct-2507。
# QuickRouter 走 OpenAI 兼容接口，因此不用 MODEL_TYPE=qwen（那条路径会强制 OpenRouter）。

# === LLM ===
OPENAI_API_KEY=sk-xxxxxxx
OPENAI_API_BASE=https://api.quickrouter.ai/v1
OPENAI_MODEL=qwen3-235b-a22b-instruct-2507
MODEL_TYPE=qwen3

# === Solver Paths ===
CVC5_BINARY=./cvc/cvc5-Linux-x86_64-static/bin/cvc5
CVC4_BINARY=./cvc/cvc4_binary/cvc4-1.6-x86_64-linux-opt
VAMPIRE_BINARY=./vampire/vampire

# === Paper runtime (个例实验沿用原文预算) ===
MAX_ATTEMPTS_PER_PROMPT=3
DEFAULT_CVC_TIMEOUT=60
COMBINED_CVC_TIMEOUT=60
MAX_RECURSION_DEPTH=3
TASK_TIMEOUT=1200
MAX_PARALLEL_TASKS=1

# === Case-study I/O ===
# 题目副本: experiments/cases/
# 运行结果: experiments/results/<timestamp>_cases/

# === Feedback-guided（个例实验默认关 routing，回到论文 portfolio） ===
SOLVER_ROUTING=off
SOLVER_ROUTING_DECIDER=relative
SOLVER_ROUTING_PROBES=off
LEMMA_LIBRARY=on
OBLIGATION_TREE=on
FEEDBACK_REPAIR_HINTS=on
FEEDBACK_PROGRESS=on
PROMPT_RETARGET=on
UNPROVED_NOT_INVALID=on
