# 706 local harvest（CVC5 + DeepSeek-v4-flash）模板。复制为同名 .env 后填入密钥。
# 用法：./run_ours_full706_cvc5_local.sh
#
# 墙钟对照旋钮（算法主路径不变）：
#   MAX_PARALLEL_TASKS=20          # 原 40；进程池读此变量
#   LLM_TIMEOUT=180                # HTTP 超时；超时后本次生成失败，进入下一 attempt
#   LLM_MAX_RETRIES=1              # 吸收一次瞬时等待；不要用 SDK 默认多次重试
#   HARVEST_RETRY_TIMEOUT=2        # timeout 收获后短再证 G；不改 60s 有用性/初始预算
# 不改：USEFULNESS_HARVEST_DELAY_S=2、DEFAULT_CVC_TIMEOUT=60、TASK_TIMEOUT=1200、attempt 次数。

# === LLM ===
OPENAI_API_KEY=sk-xxxxxxx
OPENAI_API_BASE=https://api2.aigcbest.top/v1
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Flash
MODEL_TYPE=deepseek-v4-flash
# DeepSeek V4: default disables thinking (provider default is high-on).
# Opt in with ENABLE_THINKING=true and optional REASONING_EFFORT=low|high|max.
ENABLE_THINKING=false
# REASONING_EFFORT=low
# Reasoning + answer share this budget; leave unset or set high enough to avoid empty content.
# MAX_TOKENS=16384
LLM_TIMEOUT=180
LLM_MAX_RETRIES=1

# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# === Solver Paths ===
CVC5_BINARY=./cvc/cvc5-Linux-x86_64-static/bin/cvc5
CVC4_BINARY=./cvc/cvc4_binary/cvc4-1.6-x86_64-linux-opt
VAMPIRE_BINARY=./vampire/vampire

# === Paper runtime ===
MAX_ATTEMPTS_PER_PROMPT=3
DEFAULT_CVC_TIMEOUT=60
COMBINED_CVC_TIMEOUT=60
MAX_RECURSION_DEPTH=3
TASK_TIMEOUT=1200
MAX_PARALLEL_TASKS=20

# === Current method (local harvest on) ===
SOLVER_ROUTING=off
SOLVER_ROUTING_DECIDER=relative
SOLVER_ROUTING_PROBES=off
LEMMA_LIBRARY=on
# 暂时弃用: stale failed splits vs growing library / INVALID.
OBLIGATION_TREE=off
LEMMA_LIBRARY_LOCAL=on
USEFULNESS_HARVEST_DELAY_S=2
HARVEST_RETRY_TIMEOUT=2
FEEDBACK_REPAIR_HINTS=on
# 暂时弃用: 3s sidecar + progress lemmas; do not enable by accident.
FEEDBACK_PROGRESS=off
PROMPT_RETARGET=on
# 暂时弃用: advice labels are bias, not a next-step.
PROMPT_ADVICE=off
UNPROVED_NOT_INVALID=on
SUBGOAL_SAT_ABORT=on
LEMMA_DEFINED_SYMBOLS=on
LEMMA_FILTER_DROP=on
LLM_LEMMA_DIAGNOSIS=on
CHILD_LLM_ATTEMPTS=2
LLM_PARSE_RETRIES=2
# 每行一个错误定理路径；解开后 706 运行会跳过这些题（不计入失败）。
# SKIP_PROBLEMS_FILE=experiments/configs/skip_nontheorems.txt
