# InductionScheme lightweight (structural + measure bridges) on top of
# profiler after_useless. Copy/adapt API keys and binaries from
# profiler_after_useless.env.example.

INDUCTION_SCHEME=on
# structural | measure | both
# both: short-prove all viable axes; merge nest/harvest (not winner-take-all)
INDUCTION_SCHEME_MODE=both
INDUCTION_SCHEME_TRIGGER=after_useless
# Structural G-gate (serial). Hard fail drops that axis; timeout still proves.
# Bridge-primary measure soft-skips the gate.
INDUCTION_SCHEME_GOAL_GATE=on
# Inject proved-only INDUCTION SCHEME facts into lemma prompts.
# Shows proved base/step and proved measure bridges; omits timeouts/open.
# off = still generate/prove/NEST/harvest, but omit ledger from LLM prompt.
INDUCTION_SCHEME_PROMPT=on

PROBLEM_PROFILER=on
PROBLEM_PROFILER_MIN_ATTEMPT=2
PROBLEM_PROFILER_TRIGGER=after_useless
